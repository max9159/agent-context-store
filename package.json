{
  "name": "agent-context-store-workspace",
  "version": "0.3.0",
  "description": "Agent Context Store Toolkit: Git-backed, schema-validated artifact handoff for AI agents.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm build && node --experimental-strip-types --test \"src/test/*.spec.ts\"",
    "test:integration": "pnpm build && node --experimental-strip-types --test \"src/test/integration.spec.ts\"",
    "test:e2e": "pnpm build && node --experimental-strip-types --test \"src/test/e2e/*.spec.ts\"",
    "test:coverage": "pnpm build && node --experimental-strip-types --experimental-test-coverage --test \"src/test/*.spec.ts\"",
    "check": "pnpm test",
    "smoke": "node src/packages/cli/dist/index.js --help"
  },
  "keywords": [
    "ai",
    "ai-agent",
    "ai-agents",
    "agentic-engineering",
    "multi-agent",
    "agent-handoff",
    "handoff",
    "agent-orchestration",
    "agent-workflow",
    "agent-interoperability",
    "a2a",
    "context",
    "context-store",
    "sdlc",
    "schema-validated",
    "git-backed",
    "cli"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3"
  }
}
