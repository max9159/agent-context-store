{
  "name": "agent-context-store-workspace",
  "version": "0.2.0",
  "description": "Agent Context Store Toolkit: Git-backed, schema-validated artifact handoff for AI agents.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm build && node --experimental-strip-types --test \"test/*.spec.ts\"",
    "test:integration": "pnpm build && node --experimental-strip-types --test \"test/integration.spec.ts\"",
    "test:e2e": "pnpm build && node --experimental-strip-types --test \"test/e2e/*.spec.ts\"",
    "test:coverage": "pnpm build && node --experimental-strip-types --experimental-test-coverage --test \"test/*.spec.ts\"",
    "check": "pnpm test",
    "smoke": "node packages/cli/dist/index.js --help"
  },
  "keywords": [
    "ai-agent",
    "context",
    "handoff",
    "sdlc",
    "cli"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3"
  }
}
